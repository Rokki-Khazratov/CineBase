# Copy to apps/api/.env. Every setting is optional; the defaults are shown or described.

# Database. The default is postgresql+psycopg://localhost/cinebase (a local server, your OS user).
# With the repository's compose.yaml use:
# CINEBASE_DATABASE_URL=postgresql+psycopg://cinebase:cinebase@localhost:5432/cinebase

# Wikimedia asks every client to identify itself with a contact URL or email.
# CINEBASE_WIKIDATA_USER_AGENT=CineBase/0.1 (https://github.com/Rokki-Khazratov/CineBase)

# CINEBASE_LOG_LEVEL=INFO
