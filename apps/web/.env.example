# Copy to apps/web/.env.local. Both settings are read at build time (`pnpm build`) as well as by `pnpm dev`.

# fixtures (default): the bundled 43-film set, no API needed.
# api: the CineBase API; run it first (see README).
NEXT_PUBLIC_CATALOG_SOURCE=fixtures

# Where the Next.js server reaches the API. The browser calls /api/v1 on the web origin, which is proxied here.
CINEBASE_API_URL=http://127.0.0.1:8000
