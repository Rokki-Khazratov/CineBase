{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-fixture-art.mjs && next dev",
    "build": "node scripts/sync-fixture-art.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:validate": "vitest run src/catalog/fixtures.test.ts",
    "art:sync": "node scripts/sync-fixture-art.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
